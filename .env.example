# Kopiraj u .env za lokalni razvoj (.env se NE commita). Na Renderu postavi kao Environment varijable.

PORT=3000
# Javna adresa aplikacije, bez zavrsne kose crte (na Renderu: https://tvoja-app.onrender.com)
BASE_URL=http://localhost:3000

# PostgreSQL (na Renderu Internal URL, lokalno External URL)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Stavi false samo za lokalni Postgres bez SSL-a
DATABASE_SSL=true

# Auth0 - Regular Web Application (OIDC prijava korisnika)
AUTH0_ISSUER_BASE_URL=https://TVOJ-TENANT.eu.auth0.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Dugi nasumicni niz (npr. openssl rand -hex 32)
SESSION_SECRET=

# Auth0 - API (identifier) za M2M tokene
AUTH0_AUDIENCE=